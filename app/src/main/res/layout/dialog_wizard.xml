<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark"
    android:padding="20dp">

    <!-- Header del Asistente -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✨ Asistente de Configuración"
                android:textColor="@color/secondary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_wizard_step_indicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Paso 1 de 6"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/btn_wizard_close"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:text="✕"
            android:textColor="@color/text_secondary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- Barra de progreso -->
    <ProgressBar
        android:id="@+id/wizard_progress_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:max="6"
        android:progress="1"
        android:progressTint="@color/secondary"
        android:progressBackgroundTint="@color/card_border"
        android:layout_marginBottom="16dp" />

    <!-- Contenedor dinámico de pasos -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <ViewFlipper
            android:id="@+id/wizard_view_flipper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- ============================== -->
            <!-- PASO 1: Bienvenida -->
            <!-- ============================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingTop="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌊"
                    android:textSize="64sp"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="¡Bienvenido a WallFlow!"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textAlignment="center" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tu pantalla cobrará vida con los mejores fondos verticales de alta definición sin consumir batería extra."
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:textAlignment="center"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="24dp"
                    android:lineSpacingExtra="3dp" />

                <!-- Banner para usuarios existentes -->
                <LinearLayout
                    android:id="@+id/card_wizard_existing_user"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card"
                    android:padding="14dp"
                    android:layout_marginBottom="20dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✨ Configuración previa detectada"
                        android:textColor="@color/secondary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tus carpetas y preferencias están intactas. Puedes continuar con el asistente para revisarlas o conservar tu configuración actual."
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:layout_marginTop="4dp" />

                    <android.widget.Button
                        android:id="@+id/btn_wizard_keep_existing"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_chip_unselected"
                        android:text="Conservar mi configuración actual"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:textAllCaps="false" />
                </LinearLayout>

                <!-- Beneficios clave -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card"
                    android:padding="16dp"
                    android:layout_marginBottom="28dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✓  Fondos Ultra HD verticales de Wallhaven"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✓  Rotación automática al apagar o desbloquear"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✓  Control directo con widget en pantalla de inicio"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />
                </LinearLayout>

                <android.widget.Button
                    android:id="@+id/btn_step1_next"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_button_gradient"
                    android:text="Comenzar Configuración ›"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textAllCaps="false" />
            </LinearLayout>

            <!-- ============================== -->
            <!-- PASO 2: Gustos en Wallhaven -->
            <!-- ============================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="¿Qué fondos te gustan?"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Toca una o más categorías garantizadas con miles de fondos en formato vertical para celular:"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="16dp" />

                <!-- Grid de Chips de categorías -->
                <!-- Fila 1 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:id="@+id/chip_anime"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_chip_selected"
                        android:gravity="center"
                        android:text="🎌 Anime"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/chip_fantasy"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_chip_unselected"
                        android:gravity="center"
                        android:text="⚔️ Fantasía"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/chip_gaming"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_chip_unselected"
                        android:gravity="center"
                        android:text="🎮 Gaming"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>

                <!-- Fila 2 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:id="@+id/chip_nature"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_chip_unselected"
                        android:gravity="center"
                        android:text="🌿 Paisajes"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/chip_dark"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_chip_selected"
                        android:gravity="center"
                        android:text="🖤 Oscuro/OLED"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/chip_cyberpunk"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_chip_unselected"
                        android:gravity="center"
                        android:text="💡 Cyberpunk"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>

                <!-- Fila 3 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:id="@+id/chip_minimalism"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_chip_unselected"
                        android:gravity="center"
                        android:text="✨ Minimal"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/chip_digital_art"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_chip_unselected"
                        android:gravity="center"
                        android:text="🎨 Arte Digital"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/chip_cars"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_chip_unselected"
                        android:gravity="center"
                        android:text="🚗 Autos"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="O escribe tus palabras o series favoritas:"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/et_wizard_custom_keywords"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_card"
                    android:paddingHorizontal="14dp"
                    android:hint="Ej: Chainsaw Man, Dragon Ball, Zelda, Batman"
                    android:textColorHint="@color/text_hint"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:inputType="text"
                    android:layout_marginBottom="24dp" />

                <!-- Botones de Navegación -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <android.widget.Button
                        android:id="@+id/btn_step2_back"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_chip_unselected"
                        android:text="‹ Atrás"
                        android:textColor="@color/text_secondary"
                        android:textAllCaps="false" />

                    <android.widget.Button
                        android:id="@+id/btn_step2_next"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="2"
                        android:background="@drawable/bg_button_gradient"
                        android:text="Siguiente ›"
                        android:textColor="@color/white"
                        android:textStyle="bold"
                        android:textAllCaps="false" />
                </LinearLayout>
            </LinearLayout>

            <!-- ============================== -->
            <!-- PASO 3: Carpeta y Primera Descarga -->
            <!-- ============================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Carpeta de Wallhaven"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Elige o crea una carpeta en tu teléfono donde se guardarán los fondos (recomendado: dentro de Imágenes / Pictures):"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="16dp" />

                <!-- Tarjeta de estado de carpeta -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card"
                    android:padding="16dp"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:id="@+id/tv_wizard_folder_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ninguna carpeta seleccionada"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_wizard_folder_hint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Toca el botón abajo para elegirla. Se vinculará automáticamente a Inicio y Bloqueo."
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="12dp" />

                    <android.widget.Button
                        android:id="@+id/btn_wizard_pick_wallhaven_folder"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_button_gradient"
                        android:text="📁 Elegir o Crear Carpeta"
                        android:textColor="@color/white"
                        android:textStyle="bold"
                        android:textAllCaps="false" />
                </LinearLayout>

                <!-- Sección de descarga inmediata (aparece al elegir carpeta) -->
                <LinearLayout
                    android:id="@+id/layout_wizard_download_box"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card"
                    android:padding="16dp"
                    android:layout_marginBottom="24dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/layout_wizard_download_progress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ProgressBar
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:indeterminate="true"
                            android:indeterminateTint="@color/secondary"
                            android:layout_marginEnd="12dp" />

                        <TextView
                            android:id="@+id/tv_wizard_download_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Descargando tus primeros 6 fondos en HD..."
                            android:textColor="@color/text_primary"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_wizard_download_done"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✓ ¡Listo! Se descargaron 6 fondos y están vinculados."
                        android:textColor="@color/green_success"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- Botones de Navegación -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <android.widget.Button
                        android:id="@+id/btn_step3_back"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_chip_unselected"
                        android:text="‹ Atrás"
                        android:textColor="@color/text_secondary"
                        android:textAllCaps="false" />

                    <android.widget.Button
                        android:id="@+id/btn_step3_next"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="2"
                        android:background="@drawable/bg_button_gradient"
                        android:text="Siguiente ›"
                        android:textColor="@color/white"
                        android:textStyle="bold"
                        android:textAllCaps="false"
                        android:enabled="false" />
                </LinearLayout>
            </LinearLayout>

            <!-- ============================== -->
            <!-- PASO 4: Fotos Personales (Opcional) -->
            <!-- ============================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="¿Tienes fotos personales?"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Si tienes una carpeta con tus fotos propias (cámara, familia o viajes) puedes agregarla aquí de forma opcional:"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="16dp" />

                <!-- Tarjeta de carpeta personal -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card"
                    android:padding="16dp"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:id="@+id/tv_wizard_personal_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ninguna carpeta personal agregada"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Opcional. Puedes combinar tus fotos personales con las de Wallhaven."
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="12dp" />

                    <android.widget.Button
                        android:id="@+id/btn_wizard_pick_personal_folder"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_chip_unselected"
                        android:text="📸 Agregar Carpeta Personal"
                        android:textColor="@color/secondary"
                        android:textStyle="bold"
                        android:textAllCaps="false" />

                    <!-- RadioGroup destino (aparece si eligen carpeta personal) -->
                    <RadioGroup
                        android:id="@+id/rg_wizard_personal_target"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:visibility="gone">

                        <RadioButton
                            android:id="@+id/rb_personal_both"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Usar en Inicio y en Bloqueo"
                            android:textColor="@color/text_primary"
                            android:checked="true" />

                        <RadioButton
                            android:id="@+id/rb_personal_home"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Solo en Pantalla de Inicio"
                            android:textColor="@color/text_primary" />

                        <RadioButton
                            android:id="@+id/rb_personal_lock"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Solo en Pantalla de Bloqueo"
                            android:textColor="@color/text_primary" />
                    </RadioGroup>
                </LinearLayout>

                <!-- Botones de Navegación -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="16dp">

                    <android.widget.Button
                        android:id="@+id/btn_step4_back"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_chip_unselected"
                        android:text="‹ Atrás"
                        android:textColor="@color/text_secondary"
                        android:textAllCaps="false" />

                    <android.widget.Button
                        android:id="@+id/btn_step4_next"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="2"
                        android:background="@drawable/bg_button_gradient"
                        android:text="Continuar ›"
                        android:textColor="@color/white"
                        android:textStyle="bold"
                        android:textAllCaps="false" />
                </LinearLayout>
            </LinearLayout>

            <!-- ============================== -->
            <!-- PASO 5: Frecuencia y Atenuación -->
            <!-- ============================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="¿Cómo quieres que cambien?"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ajustamos la rotación perfecta recomendada por defecto:"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="16dp" />

                <!-- Tarjeta Bloqueo -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card"
                    android:padding="14dp"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔒 Pantalla de Bloqueo"
                        android:textColor="@color/secondary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <RadioGroup
                        android:id="@+id/rg_wizard_lock_trigger"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp">

                        <RadioButton
                            android:id="@+id/rb_wizard_lock_unlock"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Al apagar o encender (Cada bloqueo) • Recomendado"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:checked="true" />

                        <RadioButton
                            android:id="@+id/rb_wizard_lock_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Por tiempo (cada 1 hora)"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp" />
                    </RadioGroup>
                </LinearLayout>

                <!-- Tarjeta Inicio -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card"
                    android:padding="14dp"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📱 Pantalla de Inicio"
                        android:textColor="@color/secondary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <RadioGroup
                        android:id="@+id/rg_wizard_home_trigger"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp">

                        <RadioButton
                            android:id="@+id/rb_wizard_home_1h"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Cada 1 hora • Recomendado"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:checked="true" />

                        <RadioButton
                            android:id="@+id/rb_wizard_home_unlock"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Al desbloquear el celular"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp" />
                    </RadioGroup>
                </LinearLayout>

                <!-- Tarjeta Atenuación Inicio -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card"
                    android:padding="14dp"
                    android:layout_marginBottom="24dp">

                    <CheckBox
                        android:id="@+id/cb_wizard_dim_home"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Atenuar fondo en pantalla de inicio (80%) para leer iconos y widgets claramente"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:checked="true" />
                </LinearLayout>

                <!-- Botones de Navegación -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <android.widget.Button
                        android:id="@+id/btn_step5_back"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_chip_unselected"
                        android:text="‹ Atrás"
                        android:textColor="@color/text_secondary"
                        android:textAllCaps="false" />

                    <android.widget.Button
                        android:id="@+id/btn_step5_next"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="2"
                        android:background="@drawable/bg_button_gradient"
                        android:text="Siguiente ›"
                        android:textColor="@color/white"
                        android:textStyle="bold"
                        android:textAllCaps="false" />
                </LinearLayout>
            </LinearLayout>

            <!-- ============================== -->
            <!-- PASO 6: ¡Listo! Aplicar Fondos -->
            <!-- ============================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingTop="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎉"
                    android:textSize="64sp"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="¡Todo Listo y Configurado!"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textAlignment="center" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="WallFlow está preparado para transformar tu teléfono. Aplicaremos tus primeros fondos nuevos ahora mismo."
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:textAlignment="center"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="24dp"
                    android:lineSpacingExtra="3dp" />

                <!-- Resumen de estado -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card"
                    android:padding="16dp"
                    android:layout_marginBottom="28dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✓  Servicio en segundo plano activado"
                        android:textColor="@color/green_success"
                        android:textSize="13sp"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✓  Fondos de Wallhaven sincronizados"
                        android:textColor="@color/green_success"
                        android:textSize="13sp"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✓  Descarga programada: 4 fotos cada 6 horas"
                        android:textColor="@color/green_success"
                        android:textSize="13sp"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✓  Widget de inicio y bloqueo disponibles"
                        android:textColor="@color/green_success"
                        android:textSize="13sp" />
                </LinearLayout>

                <android.widget.Button
                    android:id="@+id/btn_wizard_finish"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_button_gradient"
                    android:text="🚀 Aplicar Fondos y Empezar"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textAllCaps="false" />
            </LinearLayout>

        </ViewFlipper>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
